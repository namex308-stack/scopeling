{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "1.1.0",
  "default_locale": "en",
  "permissions": ["storage", "alarms", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_extensionName__"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": [
        "lib/scopeStore.js",
        "lib/matcher.js",
        "lib/templates.js",
        "content/ui/panel.js",
        "content/message-injector.js",
        "content/gmail.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://upwork.com/messages",
        "https://upwork.com/messages/*",
        "https://www.upwork.com/messages",
        "https://www.upwork.com/messages/*"
      ],
      "js": [
        "lib/scopeStore.js",
        "lib/matcher.js",
        "lib/templates.js",
        "content/ui/panel.js",
        "content/message-injector.js",
        "content/upwork.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/ui/panel.css"],
      "matches": [
        "https://mail.google.com/*",
        "https://upwork.com/messages*",
        "https://www.upwork.com/messages*"
      ]
    }
  ]
}
